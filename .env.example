APP_ENV=development
LOG_LEVEL=info

HTTP_ADDR=:8080

# Either set the discrete DB_* vars and compose POSTGRES_URL yourself,
# or set POSTGRES_URL directly. Only POSTGRES_URL is read by the app.
#
# Production (remote DB reachable over public network): use sslmode=require
# Local dev (Docker Compose postgres service):           use sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=auditrail
DB_PASSWORD=auditrail
DB_NAME=auditrail
POSTGRES_URL=postgres://auditrail:auditrail@localhost:5432/auditrail?sslmode=disable

CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=auditrail

NATS_URL=nats://localhost:4222

REDIS_ADDR=localhost:6379

ADMIN_MASTER_TOKEN=dev-master-token-change-me

# Security / rate limit tuning (optional — defaults in config.go)
# MAX_CLOCK_SKEW=5m
# NONCE_TTL=10m
# RATE_LIMIT_AUDIT=600
# RATE_LIMIT_ERROR=1200
# RATE_LIMIT_LOG=6000
# RATE_LIMIT_METRIC=6000
