{
  "info": {
    "name": "Auditrail",
    "description": "Universal Observability API. Requests are auto-signed by the collection-level pre-request script using `api_key` + `secret_key` collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:8080" },
    { "key": "api_key",      "value": "ak_live_xxx" },
    { "key": "secret_key",   "value": "sk_live_xxx" },
    { "key": "admin_token",  "value": "change-me" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-sign every request that needs HMAC. Skipped for admin routes.",
          "const url = pm.request.url.toString();",
          "if (url.includes('/v1/admin/') || url.endsWith('/healthz') || url.endsWith('/readyz')) { return; }",
          "",
          "const apiKey = pm.collectionVariables.get('api_key');",
          "const secret = pm.collectionVariables.get('secret_key');",
          "",
          "const ts    = Math.floor(Date.now() / 1000).toString();",
          "const nonce = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : ('' + Date.now() + Math.random());",
          "const body  = pm.request.body && pm.request.body.raw ? pm.request.body.raw : '';",
          "",
          "const CryptoJS = require('crypto-js');",
          "const sig = CryptoJS.HmacSHA256(ts + '\\n' + nonce + '\\n' + body, secret).toString(CryptoJS.enc.Hex);",
          "",
          "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + apiKey });",
          "pm.request.headers.upsert({ key: 'X-Timestamp',   value: ts });",
          "pm.request.headers.upsert({ key: 'X-Nonce',       value: nonce });",
          "pm.request.headers.upsert({ key: 'X-Signature',   value: 'hmac-sha256=' + sig });",
          "pm.request.headers.upsert({ key: 'Content-Type',  value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /healthz",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/healthz", "host": ["{{base_url}}"], "path": ["healthz"] } }
        },
        {
          "name": "GET /readyz",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/readyz",  "host": ["{{base_url}}"], "path": ["readyz"]  } }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "POST /v1/events (audit)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/v1/events", "host": ["{{base_url}}"], "path": ["v1","events"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"timestamp\": \"2026-01-01T00:00:00Z\",\n  \"category\": \"audit\",\n  \"severity\": \"info\",\n  \"action\": \"user.login\",\n  \"actor\":    { \"id\": \"u_123\", \"type\": \"user\" },\n  \"resource\": { \"id\": \"u_123\", \"type\": \"user\" },\n  \"context\":  { \"ip\": \"1.2.3.4\", \"user_agent\": \"PostmanRuntime\" }\n}"
            }
          }
        },
        {
          "name": "POST /v1/events (error)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/v1/events", "host": ["{{base_url}}"], "path": ["v1","events"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"22222222-2222-4222-8222-222222222222\",\n  \"timestamp\": \"2026-01-01T00:00:00Z\",\n  \"category\": \"error\",\n  \"severity\": \"error\",\n  \"action\": \"app.exception\",\n  \"payload\": { \"message\": \"null reference\", \"stack\": \"at main.go:42\" }\n}"
            }
          }
        },
        {
          "name": "POST /v1/events/bulk",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/v1/events/bulk", "host": ["{{base_url}}"], "path": ["v1","events","bulk"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"33333333-3333-4333-8333-333333333333\",\n      \"timestamp\": \"2026-01-01T00:00:00Z\",\n      \"category\": \"log\",\n      \"severity\": \"info\",\n      \"action\": \"app.log\",\n      \"payload\": { \"message\": \"hello\" }\n    },\n    {\n      \"event_id\": \"44444444-4444-4444-8444-444444444444\",\n      \"timestamp\": \"2026-01-01T00:00:01Z\",\n      \"category\": \"metric\",\n      \"severity\": \"info\",\n      \"action\": \"http.latency_ms\",\n      \"payload\": { \"value\": 42 }\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "GET /v1/events?category=audit",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/events?category=audit&limit=20",
              "host": ["{{base_url}}"],
              "path": ["v1","events"],
              "query": [
                { "key": "category", "value": "audit" },
                { "key": "limit",    "value": "20"    }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "POST /v1/admin/applications",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Admin-Token", "value": "{{admin_token}}" } ],
            "url": { "raw": "{{base_url}}/v1/admin/applications", "host": ["{{base_url}}"], "path": ["v1","admin","applications"] },
            "body": {
              "mode": "raw",
              "raw": "{ \"code\": \"upayment\", \"name\": \"uPayment\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "GET /v1/admin/applications",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-Admin-Token", "value": "{{admin_token}}" } ],
            "url": { "raw": "{{base_url}}/v1/admin/applications", "host": ["{{base_url}}"], "path": ["v1","admin","applications"] }
          }
        },
        {
          "name": "POST /v1/admin/applications/:id/rotate-key",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Admin-Token", "value": "{{admin_token}}" } ],
            "url": {
              "raw": "{{base_url}}/v1/admin/applications/:id/rotate-key",
              "host": ["{{base_url}}"],
              "path": ["v1","admin","applications",":id","rotate-key"],
              "variable": [ { "key": "id", "value": "00000000-0000-0000-0000-000000000000" } ]
            }
          }
        }
      ]
    }
  ]
}
